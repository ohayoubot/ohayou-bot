{
  "name": "ohayou-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The ohayou bot's website: the deerkins gallery, the drop uploader and the world map. Cloudflare Pages + D1.",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db": "node tools/db.mjs",
    "test": "node --test 'tools/*.test.mjs'",
    "lint": "biome ci .",
    "lint:fix": "biome check --write ."
  },
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "wrangler": "^4.123.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
