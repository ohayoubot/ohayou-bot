{
	"nick": "ohayoubot",
	"user": "ohayoubot",
	"nickPw": "",
	"server": "irc.server.net",
	"port": 6667,
	"tls": false,
	"sasl": {
		"login": "",
		"password": "",
		"mechanism": "PLAIN"
	},
	"vhost": {
		"service": "HostServ",
		"command": "ON",
		"timeout": 10000
	},
	"channels": [
		"#chan",
		"#channel2 key"
	],
	"debug": false,
	"verbose": false,
	"floodProtect": true,
	"floodDelay": 500,
	"admins": {
		"adminNick": "vhost.or.host.name"
	},
	"commandPrefix": "!",
	"ignoreList": {
		"spammerNick": "spams the bot often"
	},
	"database": "ohayoubot.db",
	"cloudflare": {
		"accountId": "",
		"databaseId": "",
		"apiToken": ""
	},
	"plugins": {
		"deerkins": {
			"editor": "https://hemera.day/deerkins/",
			"timeout": 300,
			"timeoutPunish": 1.7,
			"missTimeout": 15,
			"maxLines": 30,
			"requestTimeout": 10000,
			"privilegedMatch": ["nick", "host"],
			"privileged": {
				"someNick": {
					"host": "vhost.or.host.name",
					"timeout": 0
				}
			},
			"ignoreNicks": [],
			"ignoreHosts": [],
			"ignoreChannels": []
		},
		"youtube": {
			"enabled": true,
			"maxLinks": 2,
			"cooldown": 10,
			"repeat": 600,
			"requestTimeout": 8000,
			"ignoreChannels": []
		},
		"drop": {
			"url": "https://hemera.day/drop/",
			"imageBase": "https://img.hemera.day",
			"grantTtl": 300,
			"poll": 10,
			"cooldown": 60,
			"requestTimeout": 10000
		},
		"ohayou": {
			"enabled": true,
			"dataDir": "data",
			"timezone": "America/New_York"
		}
	}
}
